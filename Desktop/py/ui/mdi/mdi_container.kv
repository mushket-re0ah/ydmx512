#:set mdi_tiling_spacing "3dp"


<MDITilingBox>:  # BoxLayout
    spacing: mdi_tiling_spacing
    orientation: "vertical"


<MDITilingBoxContainer>:  # BoxLayout
    spacing: mdi_tiling_spacing
    padding: (mdi_tiling_spacing, 0, mdi_tiling_spacing, 0)


<MDIContainer>:  # RelativeLayout
    size_hint: (1, 1)
    if_contain: len(self.mdi_list_showed) > 0
